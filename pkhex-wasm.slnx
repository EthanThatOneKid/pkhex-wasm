<Solution>
  <Folder Name="/external/">
    <!--
      The vendored submodule must be a mapped solution member: out-of-solution
      ProjectReferences resolve through the .slnx metaproj without a
      Configuration global property, silently compiling upstream as Debug
      (live Debug.Asserts) while everything else builds Release.
    -->
    <Project Path="external/PKHeX.Everywhere/external/PKHeX/PKHeX.Core/PKHeX.Core.csproj" />
  </Folder>
  <Folder Name="/spike/">
    <Project Path="spike/SpikeApp/SpikeApp.csproj" />
    <Project Path="spike/SpikeLib.Tests/SpikeLib.Tests.csproj" />
    <Project Path="spike/SpikeLib/SpikeLib.csproj" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/PKHexWasm.Wasm/PKHexWasm.Wasm.csproj" />
    <Project Path="src/PKHexWasm/PKHexWasm.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/PKHexWasm.Tests/PKHexWasm.Tests.csproj" />
  </Folder>
</Solution>
